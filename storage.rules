rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /recipes/{allPaths=**} {
      // Semua orang dapat melihat gambar masakan (Public Read)
      allow read: if true;

      // Hanya pengguna terautentikasi yang dapat mengunggah file gambar (Maks 5MB)
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
